import tkinter as tk
import random
import math

class CutGame:
    def __init__(self, root):
        self.root = root
        self.root.title("Cut Accuracy Game")
        self.root.geometry("600x700")
        self.root.configure(bg="black")
       
        # Canvas for the game
        self.canvas = tk.Canvas(root, width=600, height=600, bg="black", highlightthickness=0)
        self.canvas.pack(pady=10)
       
        # Draw the boundary circle
        self.center_x, self.center_y = 300, 300
        self.radius = 250
        self.canvas.create_oval(
            self.center_x - self.radius, self.center_y - self.radius,
            self.center_x + self.radius, self.center_y + self.radius,
            outline="#555555", width=2
        )
       
        # Bottom UI frame
        ui_frame = tk.Frame(root, bg="black")
        ui_frame.pack()
       
        self.score_label = tk.Label(
            ui_frame, text="", font=("Arial", 16, "bold"),
            bg="black", fg="white", borderwidth=2, relief="solid"
        )
        self.score_label.pack(pady=(0, 5))
       
        self.btn_next = tk.Button(ui_frame, text="Next Shape", command=self.next_shape, font=("Arial", 12))
        self.btn_next.pack()
       
        # Game state variables
        self.poly_points = []
        self.shape_id = None
        self.line_id = None
        self.start_x = None
        self.start_y = None
        self.cut_done = False
       
        # Bind mouse events
        self.canvas.bind("<ButtonPress-1>", self.on_mouse_down)
        self.canvas.bind("<B1-Motion>", self.on_mouse_drag)
        self.canvas.bind("<ButtonRelease-1>", self.on_mouse_up)
       
        self.next_shape()

    def generate_random_convex_polygon(self):
        """Generates random points and computes their Convex Hull to ensure the polygon is convex."""
        points = []
        # Generate random points inside the circle boundary
        for _ in range(15):
            angle = random.uniform(0, 2 * math.pi)
            r = random.uniform(50, self.radius - 20)
            x = self.center_x + r * math.cos(angle)
            y = self.center_y + r * math.sin(angle)
            points.append((x, y))
           
        # Monotone chain algorithm to find the convex hull
        points = sorted(set(points))
        if len(points) <= 2:
            return points

        def cross(o, a, b):
            return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])

        lower = []
        for p in points:
            while len(lower) >= 2 and cross(lower[-2], lower[-1], p) <= 0:
                lower.pop()
            lower.append(p)

        upper = []
        for p in reversed(points):
            while len(upper) >= 2 and cross(upper[-2], upper[-1], p) <= 0:
                upper.pop()
            upper.append(p)

        return lower[:-1] + upper[:-1]

    def next_shape(self):
        self.canvas.delete("shape")
        self.canvas.delete("line")
        self.score_label.config(text="  Cut the shape!  ")
        self.cut_done = False
       
        self.poly_points = self.generate_random_convex_polygon()
       
        # Flatten points for tkinter create_polygon
        flat_points = [coord for pt in self.poly_points for coord in pt]
        self.shape_id = self.canvas.create_polygon(
            flat_points, fill="#888888", outline="white", width=1, tags="shape"
        )

    def on_mouse_down(self, event):
        if self.cut_done: return
        self.start_x, self.start_y = event.x, event.y
        self.line_id = self.canvas.create_line(
            self.start_x, self.start_y, event.x, event.y,
            fill="white", width=2, tags="line"
        )

    def on_mouse_drag(self, event):
        if self.cut_done or not self.line_id: return
        self.canvas.coords(self.line_id, self.start_x, self.start_y, event.x, event.y)

    def on_mouse_up(self, event):
        if self.cut_done or not self.line_id: return
        self.canvas.delete("line")
        end_x, end_y = event.x, event.y
       
        # Avoid zero-length lines
        if abs(end_x - self.start_x) < 2 and abs(end_y - self.start_y) < 2:
            return

        poly1, poly2 = self.split_polygon(self.poly_points, (self.start_x, self.start_y), (end_x, end_y))
       
        # If the cut is valid (it actually split the polygon into 2 viable pieces)
        if len(poly1) > 2 and len(poly2) > 2:
            self.cut_done = True
            self.canvas.delete("shape")
           
            # Draw the two parts
            p1_flat = [coord for pt in poly1 for coord in pt]
            p2_flat = [coord for pt in poly2 for coord in pt]
            self.canvas.create_polygon(p1_flat, fill="#800080", outline="white", width=1, tags="shape") # Purple
            self.canvas.create_polygon(p2_flat, fill="#888888", outline="white", width=1, tags="shape") # Grey
           
            # Calculate areas and update score
            area1 = self.polygon_area(poly1)
            area2 = self.polygon_area(poly2)
            total_area = area1 + area2
           
            if total_area > 0:
                pct1 = round((area1 / total_area) * 100)
                pct2 = 100 - pct1
                # Format to match the "smaller / larger" style similar to the reference
                score_str = f" {min(pct1, pct2)} / {max(pct1, pct2)} "
                self.score_label.config(text=score_str)

    def split_polygon(self, poly, line_p1, line_p2):
        """Splits a convex polygon using a line into two polygons."""
        def get_side(p):
            # Cross product to determine which side of the line a point falls on
            return (line_p2[0] - line_p1[0]) * (p[1] - line_p1[1]) - (line_p2[1] - line_p1[1]) * (p[0] - line_p1[0])

        def intersect(p1, p2):
            x1, y1 = p1; x2, y2 = p2
            x3, y3 = line_p1; x4, y4 = line_p2
            den = (x1 - x2) * (y3 - y4) - (y1 - y2) * (x3 - x4)
            if den == 0: return None
            t = ((x1 - x3) * (y3 - y4) - (y1 - y3) * (x3 - x4)) / den
            if 0 <= t <= 1:
                return (x1 + t * (x2 - x1), y1 + t * (y2 - y1))
            return None

        poly1, poly2 = [], []
       
        for i in range(len(poly)):
            p1 = poly[i]
            p2 = poly[(i + 1) % len(poly)]

            side1 = get_side(p1)
            side2 = get_side(p2)

            if side1 >= 0: poly1.append(p1)
            if side1 <= 0: poly2.append(p1)

            # If the edge crosses the cutting line, add intersection point to both polygons
            if (side1 > 0 and side2 < 0) or (side1 < 0 and side2 > 0):
                inter = intersect(p1, p2)
                if inter:
                    poly1.append(inter)
                    poly2.append(inter)

        return self.clean_polygon(poly1), self.clean_polygon(poly2)

    def clean_polygon(self, p_list):
        """Removes duplicate adjacent points caused by floating point precision."""
        if not p_list: return []
        res = [p_list[0]]
        for p in p_list[1:]:
            if abs(p[0]-res[-1][0]) > 1e-5 or abs(p[1]-res[-1][1]) > 1e-5:
                res.append(p)
        if len(res) > 1 and abs(res[0][0]-res[-1][0]) < 1e-5 and abs(res[0][1]-res[-1][1]) < 1e-5:
            res.pop()
        return res

    def polygon_area(self, poly):
        """Shoelace formula to calculate the area of a polygon."""
        area = 0
        for i in range(len(poly)):
            j = (i + 1) % len(poly)
            area += poly[i][0] * poly[j][1]
            area -= poly[j][0] * poly[i][1]
        return abs(area) / 2.0

if __name__ == "__main__":
    root = tk.Tk()
    app = CutGame(root)
    root.mainloop()

